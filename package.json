{
  "name": "lernvo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-lernvo.ps1",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:mobile": "npm run start --prefix mobile",
    "mobile:ios": "npm run ios --prefix mobile",
    "mobile:android": "npm run android --prefix mobile",
    "test:mobile": "npm test --prefix mobile",
    "typecheck:mobile": "npm run typecheck --prefix mobile",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend && npm install --prefix mobile",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:push": "npm run db:push --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:studio": "npm run db:studio --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
