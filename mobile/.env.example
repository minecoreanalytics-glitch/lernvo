# Local API. iOS Simulator can use 127.0.0.1; Android emulator uses 10.0.2.2.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Production / shared environments must use HTTPS. EAS builds set this per profile
# in eas.json (all profiles point at https://lernvo.com today).
# EXPO_PUBLIC_API_URL=https://lernvo.com
# The tenant is selected at sign-in (company slug) and sent as x-lernvo-tenant. Do not hardcode a tenant host.
