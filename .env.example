# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://lernvo:CHANGE_ME@localhost:5432/lernvo
POSTGRES_DB=lernvo
POSTGRES_USER=lernvo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_64_CHARS

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://lernvo.com
DOMAIN=lernvo.com

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=/api

# ─── Email (optionnel — les notifs in-app fonctionnent sans ça) ───────────────
# Laisser vide pour désactiver les emails. Compatible avec tout provider SMTP.
#
# Google Workspace / Gmail :
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=noreply@example.com  SMTP_PASS=<app-password>
#
# SendGrid :
#   SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=<SG.xxxxxxx>
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lernvo <noreply@lernvo.com>
